-- Table 1 : Propriétaires
CREATE TABLE proprietaires (
    id INT PRIMARY KEY AUTO_INCREMENT,
    nom VARCHAR(100) NOT NULL,
    prenom VARCHAR(100) NOT NULL,
    telephone VARCHAR(20),
    email VARCHAR(100)
);

-- Table 2 : Maladies
CREATE TABLE maladies (
    id INT PRIMARY KEY AUTO_INCREMENT,
    nom_maladie VARCHAR(100) NOT NULL,
    description TEXT
);

-- Table 3 : Animaux
CREATE TABLE animaux (
    id INT PRIMARY KEY AUTO_INCREMENT,
    nom VARCHAR(100) NOT NULL,
    type VARCHAR(50) NOT NULL,
    age INT,
    couleur VARCHAR(50),
    id_proprietaire INT,
    FOREIGN KEY (id_proprietaire) REFERENCES proprietaires(id) ON DELETE CASCADE
);

-- Table 4 : Visites (journal)
CREATE TABLE visites (
    id INT PRIMARY KEY AUTO_INCREMENT,
    id_animal INT,
    date_visite DATE NOT NULL,
    symptomes TEXT,
    id_maladie INT,
    traitement TEXT,
    FOREIGN KEY (id_animal) REFERENCES animaux(id) ON DELETE CASCADE,
    FOREIGN KEY (id_maladie) REFERENCES maladies(id)
);
