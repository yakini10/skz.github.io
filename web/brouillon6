$error = '';

// Gérer les actions POST
if ($_SERVER['REQUEST_METHOD'] == 'POST') {
    if (isset($_POST['action'])) {
        switch ($_POST['action']) {
            case 'delete':
                if (isset($_POST['id'])) {
                    if (deleteApplication($db, $_POST['id'])) {
                        $messages[] = "Запись успешно удалена";
                    } else {
                        $error = "Ошибка при удалении";
                    }
                }
                break;
                
            case 'update':
                if (isset($_POST['id'])) {
                    $languages = isset($_POST['languages']) ? $_POST['languages'] : [];
                    $data = [
                        'fio' => $_POST['fio'],
                        'phone' => $_POST['phone'],
                        'email' => $_POST['email'],
                        'birth_date' => $_POST['birth_date'],
                        'gender' => $_POST['gender'],
                        'biography' => $_POST['biography']
                    ];
                    
                    if (updateApplication($db, $_POST['id'], $data, $languages)) {
                        $messages[] = "Запись успешно обновлена";
                    } else {
                        $error = "Ошибка при обновлении";
                    }
                }
                break;
        }
    }
}

