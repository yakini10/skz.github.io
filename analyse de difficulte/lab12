using namespace std;

long long operations = 0;
bool checklesomorphism(const vector<vector<int>>& A, const vector<vector<int>>& B, const vector<int>& perm) {
    int n = A.size();
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            operations++;
            if (A[i][j] != B[perm[i]][perm[j]]) {
                return false;
            }
        }
    }
    return true;
}
bool arelsomorphic(const vector<vector<int>>& A, const vector<vector<int>>& B) {
    int n = A.size();
    vector<int>perm(n);
    for (int i = 0; i < n; i++) perm[i] = i;
    do {
        if (checklesomorphism(A, B, perm)) {
            return true;
        }
    } while (next_permutation(perm.begin(), perm.end()));
}

