#include<iostream>
#include<vector>
#include<stack>
#include<queue>

using namespace std;
class TreeChecker {
private:
	vector<vector<int>>adjMatrix;
	int n;
	int countEdges() {
		int edges = 0;
		for (int i = 0; i < n; i++) {
			for (int j = i + 1; j < n; j++) {
				if (adjMatrix[i][j] == 1) {
					edges++;
				}
			}
		}
		return edges;
	}
	bool isConnected() {
		if (n == 0)
			return true;
		vector<bool>visited(n, false);
		stack<int>s;
		s.push(0);
		visited[0] = true;
		while (!s.empty()) {
			int vertex = s.top();
			s.pop();
			for (int i = 0; i < n; i++) {
				if (adjMatrix[vertex][i] == 1 && !visited[i]) {
					visited[i] = true;
					s.push(i);
				}
			}
		}
		for (int i = 0; i < n; i++) {
			if (!visited[i]) {
				return false;
			}
		}
		return true;
	}
public:
	TreeChecker(const vector<vector<int>>& matrix) :adjMatrix(matrix) {
		n = matrix.size();
	}
	bool isTree() {
		if (n == 0)return true;
		int edges = countEdges();
		if (edges != n - 1) {
			return false;
		}
		return isConnected();
	}
};
void testTree(const vector<vector<int>>& matrix, int testNum, bool expected) {
	TreeChecker checker(matrix);
	bool result = checker.isTree();
	cout << "Test" << testNum << ":";
	if (result == expected) {
		cout << "Passed(resultat: " << (result ? "arbre" : "pas arbre") << ")";
	}
	else {
		cout<<"Failed (attendu: "<< (result ? "arbre" : "pas arbre") << ")";
	}
	cout << endl;
}
