#include <iostream>
#include <cmath>
#include <iomanip>
using namespace std;
double fact(int n) {
    double f = 1.0;
    for (int i = 1; i <= n; i++)
        f *= i;
    return f;
}
double erf_naive(double x) {
    double sum = 0.0;
    double PI = acos(-1);
    for (int n = 0; n < 200; n++) {
        double term = pow(-1, n) * pow(x, 2 * n + 1);
        term /= (fact(n) * (2 * n + 1));

        sum += term;
    }

    return (2.0 / sqrt(PI)) * sum;
}

int main() {
    double values[] = { 0.5, 1.0, 5.0, 10.0 };

    cout << scientific << setprecision(10);

    for (double x : values) {
        double approx = erf_naive(x);
        double exact = erf(x);

        double abs_err = fabs(approx - exact);
        double rel_err = abs_err / fabs(exact);

        cout << "" << endl;
        cout << "x = " << x << endl;
        cout << "--------------------------------------" << endl;
        cout << "Approximation : " << approx << endl;
        cout << "Valeur exacte : " << exact << endl;
        cout << "Erreur absolue: " << abs_err << endl;
        cout << "Erreur relative: " << rel_err << endl;
        cout << "______________________________________" << endl << endl;
    }

    return 0;
}


