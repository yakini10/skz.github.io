#include <iostream>
#include <cmath>
#include <iomanip>
using namespace std;

double s_calculer(double x) {
    double sum = 0.0;
    int k = 1;

    while (true) {
        double a = sqrt(pow(k, 3) + x);
        double b = sqrt(pow(k, 3) - x);

        double term = (-2.0 * x) / ((a + b) * a * b);

        if (sum + term == sum)
            break;

        sum += term;
        k++;
    }

    return sum;
}

int main() {
    cout << scientific << setprecision(10);

    double x1 = 0.5;
    double x2 = 0.999999999;

    cout << "\n x = 0.5 " << endl;
    cout << "s(x) = " << s_calculer(x1) << endl;

    cout << "\n x = 0.999999999 " << endl;
    cout << "s(x) = " << s_calculer(x2) << endl;

    return 0;
}

