#include <iostream>
#include <cmath>
#include <iomanip>
using namespace std;
double somme_acceleree(int Nmax) {
    double PI = acos(-1);
    const double pi_carre_divisee_6 = PI * PI / 6.0;
    double somme = 0.0;

    for (int n = 1; n <= Nmax; n++) {
        double terme = 1.0 / (n * n * (n * n + 1.0));
        somme += terme;
    }

    return pi_carre_divisee_6 - somme;
}

double somme_originale_lente(int N) {
    double somme = 0.0;
    for (int n = 1; n <= N; n++) {
        somme += 1.0 / (n * n + 1.0);
    }
    return somme;
}

int main() {
    cout << setprecision(15) << fixed;

    cout << " Methode acceleree \n";
    int N_acc = 1500; 
    double resultat_acc = somme_acceleree(N_acc);
    cout << "S = " << resultat_acc << " (avec " << N_acc << " termes)\n\n";

    cout << " Verification avec methode originale (N=10^7) \n";
    int N_orig = 10000000;
    double resultat_orig = somme_originale_lente(N_orig);
    cout << "S = " << resultat_orig << " (avec " << N_orig << " termes)\n";
    cout << "Difference entre les deux methodes : "<< scientific << abs(resultat_acc - resultat_orig) << "\n";

    return 0;
}
