#include <iostream>
#include<cmath>
using namespace std;

double erf_taylor(double x) {
	double PI =acos(-1);
	const double coefficient = 2.0 / sqrt(PI);
	double sum = 0.0;
	double term;
	double factoriel = 1.0;
	double puissancedex = x;
	int n = 0;
	while (true) {
		if (n % 2 == 0) {
			term=1.0 *puissancedex / (factoriel * (2 * n + 1));
		}
		else if (n % 2 != 0)
			term = -1.0 * puissancedex / (factoriel * (2 * n + 1));
		term = ((n % 2 == 0) ? 1.0 : -1.0) * puissancedex / (factoriel * (2 * n + 1));
		double new_sum = sum + term;
		if (new_sum == sum) break;

		sum = new_sum;
		n++;
		factoriel *= n;
		puissancedex *= x * x;
	}
	return coefficient * sum;
}
int main()
{
	double values[] = { 0.5,1.0,5.0,10.0 };
	for (int i = 0; i < 4; i++) {
		double x= values[i];
		cout << "X = " << x << endl;
		cout << "erf_taylor(x) = " << erf_taylor(x) << endl;
		cout << "erf(x) = " <<erf(x)<< endl;
	}
	return 0;
}


