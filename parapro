#include<iostream>
#include<vector>
#include<random>
#include<omp.h>

using namespace std;

int partition_lomuto(vector<int>& a, int gauche, int droite) {
	int pivot = a[droite];
	int i = gauche - 1;

	for (int j = gauche; j < droite; ++j) {
		if (a[j] <= pivot) {
			++i;
			swap(a[i], a[j]);
		}
	}
	swap(a[i + 1], a[droite]);
	return i + 1;
}
void quicksort_sequentiel(vector<int>& a, int gauche, int droite) {
	if (gauche >= droite)return;
	int p = partition_lomuto(a, gauche, droite);
	quicksort_sequentiel(a, gauche, p - 1);
	quicksort_sequentiel(a, p + 1, droite);

}

const int SEUIL = 20000;
void quicksort_parallele_tache(vector<int>& a, int gauche, int droite) {
	if (gauche >= droite) return;
	if (droite - gauche < SEUIL) {
		quicksort_sequentiel(a, gauche, droite);
		return;
	}
	int p = partition_lomuto(a, gauche, droite);;
#pragma omp task shared(a) firstprivate(gauche,p)
	{
		quicksort_parallele_tache(a, gauche, p - 1);
	}
#pragma omp task shared(a) firstprivate(droite,p)
	{
		quicksort_parallele_tache(a, p + 1, droite);
	}
#pragma omg taskwait
}
void quicksort_parallele(vector<int>& a) 
{
	#pragma omp parallel
	{
		#pragma omp single
		{
		quicksort_parallele_tache(a, 0, (int)a.size() - 1);
		}

	}	
}
bool est_trie(const vector<int>& a) {
	for (size_t i = 1; i < a.size(); ++i)
		if(a[i - 1] > a[i]) return false;
	return true;
}
int main() {
	string mode;
	long long n;
	cout << "Mode : seq or par"<<endl;
	cin >> mode;
	cout << "Taille du tableau : "<<endl;
	cin >> n;
	vector<int>a(n);
	mt19937_64 rng(12345);
	uniform_int_distribution<int> dist(0, 1000000);
	for (long long i = 0; i < n; i++)
		a[i] = dist(rng);
	double debut = omp_get_wtime();

	if (mode == "seq") {
		quicksort_sequentiel(a, 0, n - 1);
	}
	else if (mode == "par") {
		quicksort_parallele(a);
	}
	else {
		cout << "Mode inconnu"<<endl;
		return 1;
	}
	double fin = omp_get_wtime();
	for (long long i = 0; i < n; i++) {
		cout << a[i]<<endl;
	}
	cout << "Tri correct : " << (est_trie(a) ? "oui" : "non") << endl;
	cout << "Temps :" << fin - debut << "secondes" << endl;

	return 0;
}
