using namespace std;

const int MAXN = 1100;
short Picture[MAXN][MAXN];

long long operations = 0;

//////////////////////////////////////////////////////////////////
// Nettoyer l'image
//////////////////////////////////////////////////////////////////

void clearPicture(int n)
{
    for(int i=0;i<n;i++)
        for(int j=0;j<n;j++)
            Picture[i][j]=0;
}

//////////////////////////////////////////////////////////////////
// F : dessiner une image L
//////////////////////////////////////////////////////////////////

void F(int n,int x,int y,int h,int w)
{
    // segment vertical
    for(int i=0;i<h;i++)
        Picture[x+i][y]=1;

    // segment horizontal
    for(int j=0;j<w;j++)
        Picture[x+h-1][y+j]=1;
}

//////////////////////////////////////////////////////////////////
// S : recherche des images L
//////////////////////////////////////////////////////////////////

void S(int n)
{
    operations = 0;

    bool found=false;

    for(int i=0;i<n;i++)
    {
        for(int j=0;j<n;j++)
        {
            operations++;

            if(Picture[i][j]==1)
            {
                int h=0;
                int w=0;

                // mesurer segment vertical
                while(i+h<n && Picture[i+h][j]==1)
                {
                    operations++;
                    h++;
                }

                // mesurer segment horizontal
                while(j+w<n && Picture[i+h-1][j+w]==1)
                {
                    operations++;
                    w++;
                }

                if(h>1 && w>1)
                {
                    found=true;

                    cout<<"Image L trouvee : ";
                    cout<<"("<<i<<","<<j<<") -> ";
                    cout<<"("<<i+h-1<<","<<j+w-1<<")"<<endl;
                }
            }
        }
    }

    if(!found)
        cout<<"ne contient pas l'image"<<endl;
}

//////////////////////////////////////////////////////////////////
// P1 : programme de test
//////////////////////////////////////////////////////////////////

void P1()
{
    cout<<"\n===== TEST P1 =====\n";

    int n=50;

    clearPicture(n);

    F(n,5,5,10,6);
    F(n,20,10,12,7);
    F(n,30,30,8,5);

    S(n);
}

//////////////////////////////////////////////////////////////////
// P2 : mesure de complexité
//////////////////////////////////////////////////////////////////

void P2()
{
    cout<<"\n===== P2 : COMPLEXITE =====\n";

    srand(time(0));

    vector<int> tailles;
    vector<double> temps_moyens;

    int experiments = 20;

    for(int n=100;n<=1000;n+=100)
    {
        double total=0;

        for(int k=0;k<experiments;k++)
        {
            clearPicture(n);

            int nbImages = rand()%5 + 1;

            for(int i=0;i<nbImages;i++)
            {
                int x = rand()%(n-20);
                int y = rand()%(n-20);

                int h = rand()%10 + 5;
                int w = rand()%10 + 5;

                F(n,x,y,h,w);
            }

            S(n);

            total += operations;
        }

        double moyenne = total/experiments;

        tailles.push_back(n);
        temps_moyens.push_back(moyenne);

        cout<<"n="<<n<<"  T(n)="<<moyenne<<endl;
    }

//////////////////////////////////////////////////////////////////
// Methode des coefficients indetermines
//////////////////////////////////////////////////////////////////

    double n0 = tailles[0];
    double n1 = tailles[1];
    double n2 = tailles[2];
    double n3 = tailles[3];

    double y0 = temps_moyens[0];
    double y1 = temps_moyens[1];
    double y2 = temps_moyens[2];
    double y3 = temps_moyens[3];

    double k3 =
    (y3 - 3*y2 + 3*y1 - y0) /
    (n3*n3*n3 - 3*n2*n2*n2 + 3*n1*n1*n1 - n0*n0*n0);

    double k2 = 0;
    double k1 = 0;
    double k0 = y0;

//////////////////////////////////////////////////////////////////
// Affichage formule
//////////////////////////////////////////////////////////////////

    cout<<"\n=== FORMULE TROUVEE ===\n";

    cout<<"T(n) = "
        <<k3<<" n^3 + "
        <<k2<<" n^2 + "
        <<k1<<" n + "
        <<k0<<endl;

//////////////////////////////////////////////////////////////////
// CSV pour graphique
//////////////////////////////////////////////////////////////////

    cout<<"\n=== DONNEES CSV ===\n";
    cout<<"n,T(n)\n";

    for(int i=0;i<tailles.size();i++)
    {
        cout<<tailles[i]<<","<<temps_moyens[i]<<endl;
    }

}

//////////////////////////////////////////////////////////////////
// MAIN
//////////////////////////////////////////////////////////////////

int main()
{
    cout<<"LABORATOIRE : RECHERCHE D'IMAGES L\n";
    cout<<"===================================\n";

    P1();

    P2();

    return 0;
}



#include <iostream>
#include <vector>
#include <random>
#include <fstream>
#include <cmath>
#include <iomanip>

using namespace std;

const short BLANC = 0;
const short NOIR = 1;

const int MIN_N = 100;
const int MAX_N = 1000;
const int PAS = 100;

const int NB_EXP_PAR_N = 10;

struct ImageRect {
    int x1, y1;
    int x2, y2;
};

short** Picture = nullptr;
int current_n = 0;

long long operations = 0;

////////////////////////////////////////////////////////////

void allouerPicture(int n)
{
    if (Picture != nullptr)
    {
        for (int i = 0; i < current_n; i++)
            delete[] Picture[i];

        delete[] Picture;
    }

    Picture = new short*[n];

    for (int i = 0; i < n; i++)
        Picture[i] = new short[n];

    current_n = n;
}

////////////////////////////////////////////////////////////

void initBlanc(int n)
{
    for (int i = 0; i < n; i++)
        for (int j = 0; j < n; j++)
            Picture[i][j] = BLANC;
}

////////////////////////////////////////////////////////////
// F : crée une image L

void F(int x, int y, int taille)
{
    for (int i = 0; i < taille; i++)
    {
        int px = x + i;
        int py = y;

        if (px >= 0 && px < current_n && py >= 0 && py < current_n)
            Picture[px][py] = NOIR;
    }

    for (int j = 0; j < taille; j++)
    {
        int px = x + taille - 1;
        int py = y + j;

        if (px >= 0 && px < current_n && py >= 0 && py < current_n)
            Picture[px][py] = NOIR;
    }
}

////////////////////////////////////////////////////////////
// S : recherche des images

vector<ImageRect> S()
{
    vector<ImageRect> resultats;

    operations = 0;

    vector<vector<bool>> visite(current_n, vector<bool>(current_n,false));

    for(int i=0;i<current_n;i++)
    {
        for(int j=0;j<current_n;j++)
        {
            operations+=2;

            if(Picture[i][j]==NOIR && !visite[i][j])
            {
                operations++;

                int xmin=i,xmax=i,ymin=j,ymax=j;

                vector<pair<int,int>> pile;

                pile.push_back({i,j});

                visite[i][j]=true;

                while(!pile.empty())
                {
                    auto [x,y]=pile.back();
                    pile.pop_back();

                    if(x<xmin) xmin=x;
                    if(x>xmax) xmax=x;
                    if(y<ymin) ymin=y;
                    if(y>ymax) ymax=y;

                    operations+=4;

                    for(int dx=-1;dx<=1;dx++)
                    {
                        for(int dy=-1;dy<=1;dy++)
                        {
                            if(dx==0 && dy==0) continue;

                            int nx=x+dx;
                            int ny=y+dy;

                            operations+=2;

                            if(nx>=0 && nx<current_n && ny>=0 && ny<current_n)
                            {
                                operations+=4;

                                if(Picture[nx][ny]==NOIR && !visite[nx][ny])
                                {
                                    pile.push_back({nx,ny});
                                    visite[nx][ny]=true;

                                    operations+=2;
                                }
                            }
                        }
                    }
                }

                resultats.push_back({xmin,ymin,xmax,ymax});
            }
        }
    }

    return resultats;
}

////////////////////////////////////////////////////////////
// P1 : TEST

void P1()
{
    cout<<"===== PROGRAMME P1 (TEST) ====="<<endl;

    allouerPicture(50);

    initBlanc(50);

    F(5,5,8);
    F(20,30,10);
    F(35,10,6);

    vector<ImageRect> images=S();

    cout<<"Images trouvees : "<<images.size()<<endl;

    for(size_t i=0;i<images.size();i++)
    {
        cout<<"Image "<<i+1<<" : ("
            <<images[i].x1<<","<<images[i].y1<<") -> ("
            <<images[i].x2<<","<<images[i].y2<<")"<<endl;
    }

    cout<<"Operations : "<<operations<<endl;
}

////////////////////////////////////////////////////////////
// P2 : COMPLEXITE

void P2()
{
    cout<<"\n===== PROGRAMME P2 (COMPLEXITE) =====\n";

    vector<int> tailles;
    vector<double> Tmoy;

    random_device rd;
    mt19937 gen(rd());

    for(int n=MIN_N;n<=MAX_N;n+=PAS)
    {
        allouerPicture(n);

        long long somme=0;

        for(int k=0;k<NB_EXP_PAR_N;k++)
        {
            initBlanc(n);

            vector<ImageRect> placed;

            int nbImages=5;

            for(int i=0;i<nbImages;i++)
            {
                int x=rand()%(n-20);
                int y=rand()%(n-20);

                int taille=8+rand()%5;

                bool chevauche=false;

                for(const auto& img:placed)
                {
                    if(!(x+taille<img.x1 || x>img.x2 ||
                         y+taille<img.y1 || y>img.y2))
                    {
                        chevauche=true;
                        break;
                    }
                }

                if(!chevauche)
                {
                    F(x,y,taille);

                    placed.push_back({x,y,x+taille-1,y+taille-1});
                }
            }

            S();

            somme+=operations;
        }

        double moyenne=(double)somme/NB_EXP_PAR_N;

        tailles.push_back(n);
        Tmoy.push_back(moyenne);

        cout<<"n="<<n<<"  T(n)="<<moyenne<<endl;
    }

////////////////////////////////////////////////////////////
// sauvegarde CSV

    ofstream file("donnees_Tn.csv");

    file<<"n,T(n)\n";

    for(size_t i=0;i<tailles.size();i++)
        file<<tailles[i]<<","<<Tmoy[i]<<endl;

    file.close();

////////////////////////////////////////////////////////////
// coefficients indetermines

    if(tailles.size()>=4)
    {
        double n0=tailles[0];
        double n1=tailles[2];
        double n2=tailles[4];
        double n3=tailles[6];

        double y0=Tmoy[0];
        double y1=Tmoy[2];
        double y2=Tmoy[4];
        double y3=Tmoy[6];

        double A[4][4]={
            {1,n0,n0*n0,n0*n0*n0},
            {1,n1,n1*n1,n1*n1*n1},
            {1,n2,n2*n2,n2*n2*n2},
            {1,n3,n3*n3,n3*n3*n3}
        };

        double B[4]={y0,y1,y2,y3};

        double K[4]={0};

        for(int i=0;i<4;i++)
        {
            double pivot=A[i][i];

            for(int j=i;j<4;j++)
                A[i][j]/=pivot;

            B[i]/=pivot;

            for(int k=i+1;k<4;k++)
            {
                double f=A[k][i];

                for(int j=i;j<4;j++)
                    A[k][j]-=f*A[i][j];

                B[k]-=f*B[i];
            }
        }

        for(int i=3;i>=0;i--)
        {
            K[i]=B[i];

            for(int j=i+1;j<4;j++)
                K[i]-=A[i][j]*K[j];
        }

        cout<<"\nFormule trouvee :\n";

        cout<<"T(n) = "
            <<K[0]
            <<" + "<<K[1]<<"*n"
            <<" + "<<K[2]<<"*n^2"
            <<" + "<<K[3]<<"*n^3"<<endl;

        if(fabs(K[3])<1e-10)
            cout<<"Complexite approximative : O(n^2)\n";
    }
}

////////////////////////////////////////////////////////////

int main()
{
    cout<<"LABORATOIRE : RECHERCHE D'IMAGES (LETTRE L)\n";

    P1();

    P2();

    if(Picture!=nullptr)
    {
        for(int i=0;i<current_n;i++)
            delete[] Picture[i];

        delete[] Picture;
    }

    return 0;
}
